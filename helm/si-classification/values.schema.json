{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "SI Classifications",
  "description": "Paramètres de déploiement du SI de gestion des classifications ontologiques",
  "properties": {
    "image": {
      "type": "object",
      "title": "Image Docker",
      "properties": {
        "repository": {
          "type": "string",
          "title": "Dépôt de l'image",
          "default": "ghcr.io/cece-dgcl/si-classification"
        },
        "tag": {
          "type": "string",
          "title": "Version (tag)",
          "default": "latest"
        }
      }
    },
    "oidc": {
      "type": "object",
      "title": "Authentification SSO (OIDC)",
      "description": "Sécurise l'accès à l'application via le SSO de la plateforme",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Activer l'authentification SSO",
          "default": true
        },
        "issuerUrl": {
          "type": "string",
          "title": "URL de l'émetteur (issuer Keycloak)",
          "default": ""
        },
        "clientId": {
          "type": "string",
          "title": "Identifiant du client",
          "default": "si-classification"
        }
      }
    },
    "resources": {
      "type": "object",
      "title": "Ressources",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string", "title": "CPU demandé", "default": "100m" },
            "memory": { "type": "string", "title": "Mémoire demandée", "default": "128Mi" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string", "title": "CPU max", "default": "500m" },
            "memory": { "type": "string", "title": "Mémoire max", "default": "512Mi" }
          }
        }
      }
    }
  }
}
